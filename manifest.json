{
  "manifest_version": 3,
  "name": "SpeedX Route Copier",
  "version": "1.0.0",
  "description": "Herramienta para el dashboard de SpeedX POS. Copia reportes completos de rutas con un click, detecta el filtro activo (On Track, Completed, Amber, etc.) y abre direcciones de paquetes directamente en Google Maps.",
  "permissions": ["clipboardWrite"],
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "SpeedX Route Copier"
  },
  "content_scripts": [
    {
      "matches": ["https://pos.speedx.io/bi/dashboard*"],
      "js":  ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
