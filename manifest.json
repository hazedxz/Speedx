{
  "manifest_version": 3,
  "name": "SpeedX Route Copier",
  "version": "1.0.0",
  "description": "Herramienta para SpeedX dashboard y revisión de paquetes QC. Copia reportes de rutas y abre direcciones en Google Maps.",
  "permissions": ["clipboardWrite"],
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "SpeedX Route Copier"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pos.speedx.io/bi/dashboard*",
        "https://pos.opsfleet.us/pages/qc-package-review.php*"
      ],
      "js":  ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
